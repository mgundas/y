# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
#   cp .env.example .env.local
# Only DATABASE_URL / BETTER_AUTH_* are read by `next dev` and `next build`.
# Migrations and the seed script read DATABASE_URL_DIRECT, falling back to
# DATABASE_URL. See README "Database" for why the direct URL matters on Neon.
# ---------------------------------------------------------------------------

# Neon pooled connection string (the "-pooler." host). Use this at runtime.
# Neon dashboard -> Connection Details -> "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct (non-pooled) connection string. REQUIRED for `pnpm db:migrate`
# and `pnpm db:seed`: Neon's pooler is in transaction mode, which breaks
# DDL and some session state. Neon dashboard -> "Direct connection"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign sessions and tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this logs everyone out.
BETTER_AUTH_SECRET=""

# Public origin of the app, no trailing slash. Used for auth callbacks and
# absolute URLs in emails/metadata.
BETTER_AUTH_URL="http://localhost:3000"

# Optional. If set, must match BETTER_AUTH_URL. Used where Next.js needs the
# origin on the client-safe side of the boundary.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Where uploaded images are written for the local fallback
# (Phase 7). Defaults to ./public/uploads. Local disk writes do NOT work on
# serverless hosts like Vercel - switch to object storage before deploying.
UPLOADS_DIR="./public/uploads"
